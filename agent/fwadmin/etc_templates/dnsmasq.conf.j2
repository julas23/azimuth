{# gera /etc/dnsmasq.conf #}
# ATENCAO: arquivo gerado pelo fwadmin a partir de /etc/fwadmin/config.yaml.
# Edicoes manuais sao perdidas no proximo apply. Edite o config.yaml.

# --- interface e dominio local ---------------------------------------------
interface={{ lan.device }}
{% if dns.bind_interfaces %}
bind-interfaces
{% endif %}
domain={{ dns.domain }}
{% if dns.expand_hosts %}
expand-hosts
{% endif %}
{% if dns.local_only %}
local=/{{ dns.domain }}/
{% endif %}

{% if dhcp.enabled %}
# --- DHCP -------------------------------------------------------------------
{% if dhcp.authoritative %}
dhcp-authoritative
{% endif %}
dhcp-range={{ dhcp.range.start }},{{ dhcp.range.end }},{{ dhcp.range.netmask }},{{ dhcp.range.lease }}
dhcp-option=option:router,{{ dhcp.router or lan.ipv4.address.split('/')[0] }}
dhcp-option=6,{{ (dhcp.dns_servers or [lan.ipv4.address.split('/')[0]]) | join(',') }}

# --- reservas por MAC -------------------------------------------------------
{% for r in dhcp.reservations if r.enabled %}
dhcp-host={{ r.mac }},{{ r.ip }},{{ r.name }}{% if r.description %}  # {{ r.description }}{% endif %}

{% endfor %}
{% if dhcp.held %}

# --- IPs segurados: o MAC zerado nunca casa, e o dnsmasq nao entrega o IP ---
{% for ip in dhcp.held %}
dhcp-host=00:00:00:00:00:00,{{ ip }}
{% endfor %}
{% endif %}
{% endif %}

# --- registros de host ------------------------------------------------------
{% for h in hosts %}
{% if h.dns %}
address=/{{ h.fqdn(dns.domain) }}/{{ h.ip }}
{% endif %}
{% endfor %}

{% if resolver.enabled %}
# --- quem responde o que nao e' da casa: o unbound do modelo ---------------
no-resolv
{% if dns.proxy_dnssec %}
proxy-dnssec
{% endif %}
server={{ resolver.dnsmasq_server }}
# a versao que a prova de funcao le no unbound nao sai para a LAN
local=/azimuth/
{% elif dns.upstream or dns.no_resolv or dns.proxy_dnssec %}
# --- resolvedores upstream --------------------------------------------------
{% if dns.no_resolv %}
no-resolv
{% endif %}
{% if dns.proxy_dnssec %}
proxy-dnssec
{% endif %}
{% for s in dns.upstream %}
server={{ s }}
{% endfor %}
{% endif %}
