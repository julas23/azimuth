#!/usr/sbin/nft -f
# ATENCAO: arquivo gerado pelo fwadmin a partir de /etc/fwadmin/config.yaml.
# Edicoes manuais sao perdidas no proximo apply. Edite o config.yaml.
#
# O motor e' dono so da tabela 'inet azimuth'. O resto do ruleset — o
# /etc/nftables.conf do administrador, a tabela do fail2ban — fica como esta:
# este arquivo apaga e recria apenas a propria tabela, numa transacao so.
#
# Convivencia: um pacote passa por todas as cadeias-base do mesmo gancho, e
# um drop em qualquer tabela e' final. Por isso a entrada fechada daqui vale
# mesmo que outra tabela aceite tudo — e uma regra que o modelo nao conhece
# (NETMAP, por exemplo) continua funcionando no arquivo do administrador.

table inet azimuth
delete table inet azimuth

define WAN = {{ wan_devices | nft_set }}

table inet azimuth {
    chain input {
        type filter hook input priority filter; policy {{ firewall.input_policy.value }};

        # base: o que toda caixa precisa com a entrada fechada (render.base_input)
{% for line, why in base_input %}
        {{ line }}
{% endfor %}

        # excecoes do config.yaml
{% for rule in firewall.input_rules %}
{% for line in rule_to_nft(rule) %}
        {{ line }}
{% endfor %}
{% endfor %}
    }

    chain forward {
        type filter hook forward priority filter; policy {{ firewall.forward_policy.value }};

        # trafego de volta e ajuste de MSS: precisam vir antes das regras
        ct state established,related accept
        tcp flags syn tcp option maxseg size set rt mtu
{% if cfg.containers.enabled %}

        # containers saem para a internet; da LAN eles so sao alcancados pelo
        # nginx, no proprio firewall, e isso nao passa por aqui
        ip saddr {{ cfg.containers.pool }} oifname $WAN counter accept comment "containers para a internet"
{% endif %}

{% for rule in firewall.forward_rules %}
{% for line in rule_to_nft(rule) %}
        {{ line }}
{% endfor %}
{% endfor %}
{% for pf in firewall.port_forwards %}
{% if pf.enabled %}
{% for proto in (['tcp','udp'] if pf.proto == 'tcp/udp' else [pf.proto]) %}
        iifname "{{ cfg.iface(pf.interface).ppp_device }}" ip daddr {{ pf.to_ip }} {{ proto }} dport {{ pf.to_port }} counter accept comment "fwd: {{ pf.description or pf.wan_port }}"
{% endfor %}
{% endif %}
{% endfor %}
    }

{% if firewall.port_forwards %}
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;

{% for pf in firewall.port_forwards %}
{% if pf.enabled %}
{% for proto in (['tcp','udp'] if pf.proto == 'tcp/udp' else [pf.proto]) %}
        iifname "{{ cfg.iface(pf.interface).ppp_device }}"{% if pf.source_filter %} ip saddr {{ pf.source_filter }}{% endif %} {{ proto }} dport {{ pf.wan_port }} counter dnat ip to {{ pf.to_ip }}:{{ pf.to_port }} comment "{{ pf.description or 'port-forward' }}"
{% endfor %}
{% endif %}
{% endfor %}
    }

{% endif %}
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
{% if cfg.containers.enabled %}
        oifname $WAN ip saddr {{ cfg.containers.pool }} masquerade comment "NAT dos containers"
{% endif %}

{% for name in firewall.masquerade %}
        oifname "{{ cfg.iface(name).ppp_device }}" masquerade comment "NAT {{ name }}"
{% endfor %}
{% for m in firewall.masquerade_rules %}
        oifname "{{ device_of(m.interface) }}"{% if m.source %} ip saddr {{ m.source }}{% endif %} masquerade{% if m.description %} comment "{{ m.description }}"{% endif %}

{% endfor %}
    }
}
