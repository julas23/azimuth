{# gera /etc/ppp/peers/<peer> #}
# ATENCAO: arquivo gerado pelo fwadmin a partir de /etc/fwadmin/config.yaml.
# A senha NAO fica aqui: vem de /etc/ppp/chap-secrets (modo 0600).
plugin rp-pppoe.so
{{ iface.device }}
user "{{ ppp.username }}"
noipdefault
hide-password
noauth
persist
maxfail 0
holdoff {{ ppp.holdoff }}
{% if ppp.mtu %}
mtu {{ ppp.mtu }}
{% endif %}
{% if ppp.mru %}
mru {{ ppp.mru }}
{% endif %}
noaccomp
default-asyncmap
{% if ppp.default_route %}
{# sem failover, o pppd e' o dono da rota padrao (pppoe.default_route) #}
defaultroute
replacedefaultroute
{% else %}
{# com failover, a rota default e' do wan-failover.sh, nunca do pppd —
   senao os dois brigam pela tabela de rotas #}
nodefaultroute
{% endif %}
{% if ppp.lcp_echo_interval %}
lcp-echo-interval {{ ppp.lcp_echo_interval }}
lcp-echo-failure {{ ppp.lcp_echo_failure }}
{% endif %}
{% if not ppp.unit %}
{# o poff acha o pppd pelo linkname; com o systemd, quem acha e' ele #}
linkname {{ ppp.peer }}
ipparam {{ ppp.peer }}
{% endif %}
