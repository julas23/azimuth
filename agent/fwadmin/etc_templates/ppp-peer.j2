{# gera /etc/ppp/peers/<peer> #}
# ATENCAO: arquivo gerado pelo fwadmin a partir de /etc/fwadmin/config.yaml.
# A senha NAO fica aqui: vem de /etc/ppp/chap-secrets (modo 0600).
plugin rp-pppoe.so
{{ iface.device }}
user "{{ ppp.username }}"
noipdefault
hide-password
noauth
persist
maxfail 0
holdoff {{ ppp.holdoff }}
mtu {{ ppp.mtu }}
mru {{ ppp.mru }}
noaccomp
default-asyncmap
{# a rota default e' responsabilidade do fwadmin (link primario/failover),
   nunca do pppd — senao os dois brigam pela tabela de rotas #}
nodefaultroute
lcp-echo-interval {{ ppp.lcp_echo_interval }}
lcp-echo-failure {{ ppp.lcp_echo_failure }}
linkname {{ ppp.peer }}
ipparam {{ ppp.peer }}
