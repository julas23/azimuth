#!/usr/bin/env python3
"""fwctl — o unico componente do fwadmin que roda como root.

A interface web roda sem privilegio e nunca toca em /etc. Quando ela quer
mudar alguma coisa, grava a proposta em /etc/fwadmin/config.pending.yaml e
chama `sudo fwctl apply`. Este script le apenas caminhos fixos: nada que venha
da UI vira caminho, argumento de shell ou nome de arquivo.

    fwctl check      valida a config pendente e mostra o que mudaria
    fwctl apply      aplica, recarrega e arma o rollback automatico
    fwctl confirm    confirma o apply e grava no git
    fwctl rollback   desfaz o ultimo apply
    fwctl status     mostra se ha apply aguardando confirmacao
    fwctl inventory  o que o motor possui, e o que roda aqui sem dono
    fwctl seal       sela o /etc atual como referencia de posse
    fwctl observe    fotografa o /etc vivo, sem segredos, para o painel ler
    fwctl ack        lista as mudancas da adocao e marca as intencionais
"""

from __future__ import annotations

import argparse
import ipaddress
import json
import os
import pwd
import shutil
import sys
import time
from datetime import datetime
from pathlib import Path

import yaml

sys.path.insert(0, os.environ.get("FWADMIN_CODE", "/opt/fwadmin"))

from fwadmin import acks, agentes, importer, observe, ownership, paths, secretstore, services  # noqa: E402
from fwadmin.apply import (  # noqa: E402
    ApplyError,
    Plan,
    State,
    arm_watchdog,
    build_plan,
    disarm_watchdog,
    install,
    restore,
    run,
)
from fwadmin.models import Config  # noqa: E402
from fwadmin.render import dump, load  # noqa: E402

BOLD, RED, GREEN, YELLOW, DIM, OFF = (
    ("\033[1m", "\033[31m", "\033[32m", "\033[33m", "\033[2m", "\033[0m")
    if sys.stdout.isatty()
    else ("", "", "", "", "", "")
)


def say(msg: str = "") -> None:
    print(msg, flush=True)


def fail(msg: str) -> int:
    say(f"{RED}erro:{OFF} {msg}")
    return 1


def require_root() -> None:
    if os.geteuid() != 0 and not paths.sandboxed():
        raise SystemExit("fwctl precisa rodar como root (use sudo)")


# ---------------------------------------------------------------------------
# posse
# ---------------------------------------------------------------------------


ROTULO = {
    ownership.INTACTO: f"{GREEN}intacto{OFF}",
    ownership.DIVERGENTE: f"{RED}editado a mao{OFF}",
    ownership.AUSENTE: f"{RED}sumiu do sistema{OFF}",
    ownership.ILEGIVEL: f"{YELLOW}nao consegui ler{OFF}",
    ownership.SEM_SELO: f"{DIM}sem selo{OFF}",
}


def seal_now(motivo: str, verbose: bool = False) -> None:
    """Sela o /etc atual, se ele for mesmo o que o motor escreveria.

    Falha de selo nunca derruba quem chamou: o confirm ja aconteceu, o
    rollback ja restaurou, e nao selar deixa o sistema num estado honesto —
    'sem selo' — que a proxima rodada resolve. Perder o apply por causa do
    carimbo seria trocar o problema por um pior.
    """
    try:
        cfg = load(paths.CONFIG)
    except Exception as exc:  # noqa: BLE001
        say(f"{YELLOW}selo nao gravado ({motivo}): config nao carrega — {exc}{OFF}")
        return

    try:
        selados, recusados = ownership.seal(cfg)
    except Exception as exc:  # noqa: BLE001
        say(f"{YELLOW}selo nao gravado ({motivo}): {exc}{OFF}")
        return

    if verbose or recusados:
        say(f"{DIM}selo ({motivo}): {len(selados)} arquivos{OFF}")
    for name, porque in recusados:
        say(f"  {YELLOW}nao selado{OFF} {name}: {porque}")


def show_drift(posses: list, bloqueiam: list, absorvidas: list = ()) -> None:
    """Diz quem mexeu em que, e o que isso impede."""
    say()
    say(f"{RED}{BOLD}arquivos editados fora do motor:{OFF}")
    for p in posses:
        if p in absorvidas:
            marca = f"{GREEN}ja no modelo{OFF}"
        elif p in bloqueiam:
            marca = f"{RED}bloqueia{OFF}"
        else:
            marca = f"{YELLOW}aviso{OFF}"
        say(f"  [{marca}] {p.target}  {DIM}({p.service}, {p.state}){OFF}")


def drift_gate(proposed, current, changed: list[str]) -> tuple[list, list, list]:
    """(divergentes, bloqueiam, absorvidas).

    Bloqueia so o divergente que o apply sobrescreveria e cuja edicao o
    modelo proposto ainda nao contem. A base do que foi selado e' a config
    viva ou, se ela foi mexida sem apply, o ultimo commit do git.
    """
    divergiram = ownership.divergentes(proposed)
    tocados = [p for p in divergiram if p.name in changed]
    if not tocados:
        return divergiram, [], []
    bases = [c for c in (current, committed_config()) if c is not None]
    absorvidas = [p for p in tocados if ownership.absorvida(p, proposed, bases)]
    return divergiram, [p for p in tocados if p not in absorvidas], absorvidas


# ---------------------------------------------------------------------------
# planejamento
# ---------------------------------------------------------------------------


def load_configs(source: Path) -> tuple[object, object]:
    """Le a config proposta e a atualmente aplicada."""
    if not source.exists():
        raise ApplyError(f"nada para aplicar: {source} nao existe")
    proposed = load(source)
    current = load(paths.CONFIG) if paths.CONFIG.exists() else None
    return proposed, current


def show_plan(plan: Plan) -> None:
    if not plan.changed:
        say(f"{GREEN}nada a fazer{OFF} — /etc ja esta igual a config")
        return

    say(f"{BOLD}arquivos que mudam ({len(plan.changed)}){OFF}")
    for name in plan.changed:
        say(f"  {name:22s} {DIM}->{OFF} {plan.targets[name]}")

    say()
    say(f"{BOLD}validacao de sintaxe{OFF}")
    for check in plan.checks:
        mark = f"{GREEN}OK{OFF}" if check.ok else f"{RED}FALHOU{OFF}"
        say(f"  [{mark}] {check.command}")
        if not check.ok:
            for line in check.output.splitlines():
                say(f"       {RED}{line}{OFF}")

    if plan.reloads:
        say()
        say(f"{BOLD}recargas{OFF}")
        for action in plan.reloads:
            flag = f" {YELLOW}(derruba trafego){OFF}" if action.disruptive else ""
            say(f"  {action.label}{flag}")


def show_provas(provas: list) -> None:
    """Mostra a prova de funcao de cada servico mexido."""
    if not provas:
        return
    say()
    say(f"{BOLD}prova de funcao{OFF}")
    for prova in provas:
        if prova.ok:
            mark = f"{GREEN}OK{OFF}"
        elif prova.conclusive:
            mark = f"{RED}FALHOU{OFF}"
        else:
            mark = f"{YELLOW}?{OFF}"
        say(f"  [{mark}] {prova.service}: {prova.expected}")
        if prova.observed:
            say(f"       {DIM}{prova.observed}{OFF}")


# ---------------------------------------------------------------------------
# comandos
# ---------------------------------------------------------------------------


def cmd_check(args: argparse.Namespace) -> int:
    source = paths.PENDING if paths.PENDING.exists() else paths.CONFIG
    proposed, current = load_configs(source)
    say(f"{DIM}config: {source}{OFF}\n")
    plan = build_plan(proposed, current, paths.STAGING)
    show_plan(plan)

    divergiram, bloqueiam, absorvidas = drift_gate(proposed, current, plan.changed)
    if divergiram:
        show_drift(divergiram, bloqueiam, absorvidas)

    if not plan.valid:
        return fail("a config nao passou na validacao de sintaxe — apply bloqueado")
    return 0


def cmd_apply(args: argparse.Namespace) -> int:
    require_root()

    if (state := State.load()) is not None:
        return fail(
            f"ja existe um apply aguardando confirmacao ({state.remaining}s restantes).\n"
            "       Rode 'fwctl confirm' ou 'fwctl rollback' antes de aplicar de novo."
        )

    # ---- adocao: o que este apply mudaria que ninguem disse que queria? --
    if not ownership.read_seal():
        pending = adoption_pending()
        if pending is None:
            return fail("nao consegui ler a maquina para conferir a adocao — nada foi tocado")
        if pending:
            say()
            say(f"{RED}{BOLD}adocao: {len(pending)} mudancas ainda nao marcadas como intencionais:{OFF}")
            for cid, text in pending:
                say(f"  {DIM}{cid}{OFF}  {text}")
            say()
            return fail(
                "o primeiro apply nesta maquina mudaria o que esta acima, e ninguem marcou\n"
                "       essas mudancas como intencionais — nada foi tocado.\n"
                "       Marque no painel (Sistema) ou com 'fwctl ack <id>'. O que nao for\n"
                "       intencional precisa virar config antes: e' o modelo que esta errado."
            )

    source = paths.PENDING if paths.PENDING.exists() else paths.CONFIG
    proposed, current = load_configs(source)
    plan = build_plan(proposed, current, paths.STAGING)

    show_plan(plan)
    if not plan.changed:
        paths.PENDING.unlink(missing_ok=True)
        return 0
    if not plan.valid:
        return fail("validacao de sintaxe falhou — nada foi tocado em /etc")

    # ---- divergencia: alguem editou /etc a mao desde o ultimo apply? -----
    # Bloqueia o que ela toca, e avisa sobre o resto. Barrar um apply de DNS
    # por causa de uma edicao a mao no nftables castigaria a pessoa errada e,
    # pior, deixaria o firewall impedido de mudar qualquer coisa justo na hora
    # em que alguem mexeu nele as pressas.
    divergiram, bloqueiam, absorvidas = drift_gate(proposed, current, plan.changed)
    if divergiram:
        show_drift(divergiram, bloqueiam, absorvidas)
    if bloqueiam and not args.discard_drift:
        say()
        return fail(
            "este apply sobrescreveria edicao feita fora do motor — nada foi tocado.\n"
            "       'fwctl diff' mostra a edicao (sem config pendente, ela e' o diff inteiro).\n"
            "       Para manter a edicao, traga-a para o config.yaml e aplique de novo.\n"
            "       Para descartar, 'fwctl apply --discard-drift' — uma copia e' guardada antes."
        )

    if plan.disruptive and not (args.yes or args.force):
        say()
        return fail(
            "este apply derruba trafego (interface ou PPPoE reiniciam).\n"
            "       Confirme com 'fwctl apply --yes'."
        )

    # ---- a partir daqui /etc e' tocado -----------------------------------
    if absorvidas:
        say()
        say(f"{GREEN}edicao a mao ja contida no modelo{OFF} — o arquivo novo a mantem")
    if bloqueiam or absorvidas:
        guardado = ownership.stash(bloqueiam + absorvidas)
        if guardado is not None and bloqueiam:
            say()
            say(f"{YELLOW}edicao a mao descartada{OFF} — copia guardada em {guardado}")

    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    backup = paths.BACKUPS / stamp
    say()
    say(f"{BOLD}aplicando{OFF} (backup em {backup})")

    if paths.CONFIG.exists():
        backup.mkdir(parents=True, exist_ok=True)
        shutil.copy2(paths.CONFIG, backup / "config.yaml")

    installed = install(
        paths.STAGING, backup, plan.changed, plan.targets, plan.executable, plan.secret
    )
    for name in installed:
        say(f"  instalado {plan.targets[name]}")

    paths.CONFIG.parent.mkdir(parents=True, exist_ok=True)
    paths.CONFIG.write_text(
        dump(
            proposed,
            header="# Config VIVA do fwadmin. Alterada pela UI; versionada em git.\n",
        )
    )
    paths.PENDING.unlink(missing_ok=True)

    # Unidades sem dono que mexem no servico sozinhas param ate o confirm ou o
    # rollback: um healthcheck que reinicia o unbound no meio da prova faria a
    # prova medir o restart dele, e nao o apply.
    paused = pause_quiet(services.quiet(proposed, plan.changed))

    say()
    for action in plan.reloads:
        result = run(*action.argv, timeout=120)
        mark = f"{GREEN}OK{OFF}" if result.ok else f"{RED}FALHOU{OFF}"
        say(f"  [{mark}] {action.label}")
        if not result.ok and result.output:
            for line in result.output.splitlines()[:5]:
                say(f"       {RED}{line}{OFF}")

    # O estado e' gravado ANTES da prova: se a prova reprovar, o rollback
    # precisa do mapa do backup, e quem tem o mapa e' o state.
    timeout = proposed.system.confirm_timeout
    # Descartar edicao a mao entra no historico. O git de /etc/fwadmin e' o
    # unico lugar onde daqui a seis meses alguem descobre por que o ajuste que
    # ele fez numa madrugada nao esta mais la.
    nota = args.note or read_note()
    if bloqueiam:
        alvos = ", ".join(p.target for p in bloqueiam)
        nota = f"{nota} " if nota else ""
        nota = f"{nota}[descartou edicao feita a mao em: {alvos}]"
    state = State(
        backup=str(backup),
        at=time.time(),
        timeout=timeout,
        files=installed,
        reloads=[a.label for a in plan.reloads],
        note=nota,
        paused=paused,
    )
    state.save()

    # ---- prova de funcao -------------------------------------------------
    # Codigo de retorno de recarga nao e' evidencia: em 2026-08-21 o 'pon'
    # devolveu zero com a WAN caida. Aqui se pergunta ao sistema vivo, e
    # reprovacao reverte na hora — esperar os 90s do watchdog so faria
    # sentido se ninguem soubesse que quebrou.
    provas = services.provas(proposed, current, plan.changed)
    show_provas(provas)

    reprovadas = [p for p in provas if p.fatal]
    if reprovadas:
        motivo = "prova de funcao: " + "; ".join(
            f"{p.service} ({p.observed})" for p in reprovadas
        )
        say()
        say(f"{RED}{BOLD}a prova de funcao reprovou.{OFF} Revertendo sem esperar o watchdog.")
        revert(state, motivo, auto=True)
        return 1

    if args.no_watchdog:
        say(f"\n{YELLOW}watchdog desarmado por --no-watchdog{OFF}")
    else:
        armed = arm_watchdog(timeout)
        if not armed.ok:
            say(f"\n{RED}nao consegui armar o watchdog{OFF}: {armed.output}")
            say("Confirme ou reverta manualmente — nao ha rede de seguranca ativa.")
        else:
            say()
            say(f"{YELLOW}{BOLD}CONFIRME EM {timeout}s{OFF}{YELLOW} ou tudo volta sozinho.{OFF}")
            say(f"  {BOLD}fwctl confirm{OFF}   mantem as mudancas")
            say(f"  {BOLD}fwctl rollback{OFF}  desfaz agora")
    return 0


def cmd_confirm(args: argparse.Namespace) -> int:
    require_root()
    state = State.load()
    if state is None:
        say("nada aguardando confirmacao")
        return 0

    disarm_watchdog()
    State.clear()
    resume_quiet(state.paused)
    say(f"{GREEN}confirmado{OFF} — {len(state.files)} arquivos mantidos")

    # O selo so e' gravado aqui, e nao no apply: ate o confirm o estado ainda
    # pode voltar sozinho, e um selo de estado que o watchdog desfez apontaria
    # para um /etc que deixou de existir.
    seal_now("confirm")
    # a senha proposta pelo painel vira a definitiva junto com a config
    secretstore.commit()

    git_commit(state.note or "apply via fwadmin")
    return 0


def pause_quiet(units: list[str]) -> list[str]:
    """Para as unidades ativas da lista e devolve quais parou de fato."""
    paused = []
    for unit in units:
        if run("systemctl", "is-active", "--quiet", unit, mutating=False).ok:
            if run("systemctl", "stop", unit).ok:
                say(f"  {DIM}pausado ate o confirm: {unit}{OFF}")
                paused.append(unit)
    return paused


def resume_quiet(units: list[str]) -> None:
    for unit in units:
        result = run("systemctl", "start", unit)
        if result.ok:
            say(f"  {DIM}religado: {unit}{OFF}")
        else:
            say(f"  {YELLOW}nao consegui religar {unit}{OFF}: {result.output}")


def revert(state: State, reason: str, auto: bool = False) -> int:
    """Desfaz o ultimo apply. Caminho unico do rollback.

    Usado pelo comando manual, pelo watchdog e pela prova de funcao que
    falhou — os tres precisam do mesmo caminho, senao a rede de seguranca
    tem versoes diferentes conforme quem puxa a corda.
    """
    backup = Path(state.backup)
    if not (backup / "MANIFEST.json").exists():
        return fail(f"backup {backup} incompleto — reverta a mao")

    say(f"{YELLOW}revertendo{OFF} — {reason}")

    restored = restore(backup)
    for name in restored:
        say(f"  restaurado {name}")

    saved = backup / "config.yaml"
    if saved.exists():
        shutil.copy2(saved, paths.CONFIG)

    # Recarrega tudo que o apply havia mexido, para o /etc restaurado valer.
    # Se a config restaurada nao carregar, ainda assim recarregamos o que da:
    # os arquivos ja estao de volta no lugar, o que importa e' os daemons verem.
    try:
        previous = load(paths.CONFIG) if paths.CONFIG.exists() else None
    except Exception as exc:  # noqa: BLE001
        say(f"  {YELLOW}config restaurada nao valida ({exc}){OFF} — recarga parcial")
        previous = None

    for action in services.rollback_reloads(previous, state.files):
        result = run(*action.argv, timeout=120)
        mark = f"{GREEN}OK{OFF}" if result.ok else f"{RED}FALHOU{OFF}"
        say(f"  [{mark}] {action.label}")

    disarm_watchdog()
    State.clear()
    resume_quiet(state.paused)

    # Depois do rollback o /etc restaurado tambem e' estado oficial: sem
    # reselar, o proximo apply acusaria de "editado a mao" um arquivo que quem
    # escreveu foi o proprio rollback.
    seal_now("rollback")

    if auto:
        run("logger", "-t", "fwadmin", f"apply revertido: {reason}")
    say(f"{GREEN}rollback concluido{OFF}")
    return 0


def cmd_rollback(args: argparse.Namespace) -> int:
    require_root()
    state = State.load()
    if state is None:
        say("nada para reverter")
        return 0
    reason = "watchdog (apply nao confirmado)" if args.auto else "pedido manual"
    return revert(state, reason, auto=args.auto)


def cmd_status(args: argparse.Namespace) -> int:
    state = State.load()
    if state is None:
        say(f"{GREEN}estavel{OFF} — nenhum apply aguardando confirmacao")
    else:
        when = datetime.fromtimestamp(state.at).strftime("%H:%M:%S")
        say(f"{YELLOW}aguardando confirmacao{OFF} desde {when}")
        say(f"  restam {state.remaining}s antes do rollback automatico")
        say(f"  arquivos: {', '.join(state.files)}")
        say(f"  backup:   {state.backup}")

    say()
    say(f"config viva:   {paths.CONFIG}{'' if paths.CONFIG.exists() else '  (ausente)'}")
    if paths.PENDING.exists():
        say(f"{YELLOW}config pendente:{OFF} {paths.PENDING}  (nao aplicada)")

    try:
        posses = ownership.survey(load(paths.CONFIG)) if paths.CONFIG.exists() else []
    except Exception:  # noqa: BLE001 — status nunca morre por causa da config
        posses = []
    if posses:
        fora = [p for p in posses if p.divergiu]
        sem = [p for p in posses if p.state == ownership.SEM_SELO]
        if fora:
            say(f"{RED}posse: {len(fora)} de {len(posses)} arquivos editados fora do motor{OFF}"
                f"  {DIM}(fwctl inventory){OFF}")
        elif sem:
            say(f"{DIM}posse: {len(posses) - len(sem)} de {len(posses)} arquivos selados"
                f"  (fwctl seal){OFF}")
        else:
            say(f"{GREEN}posse: os {len(posses)} arquivos do motor estao intactos{OFF}")
    return 0


def adoption_changes() -> list[str] | None:
    """Tudo o que a adocao mudaria. None = nao deu para ler a maquina.

    Le o /etc vivo do mesmo jeito que o painel — fotografia e importador —,
    para que a lista que trava aqui seja a mesma que a pessoa viu na tela.
    """
    try:
        observe.collect()
        _, _, changes = importer.run(observe.LIVE)
    except Exception as exc:  # noqa: BLE001 — root: diz o motivo, nao trava em traceback
        say(f"{YELLOW}leitura da maquina falhou: {type(exc).__name__}: {exc}{OFF}")
        return None
    return changes


def adoption_pending() -> list[tuple[str, str]] | None:
    changes = adoption_changes()
    return None if changes is None else acks.split(changes)[0]


def cmd_ack(args: argparse.Namespace) -> int:
    """Sem argumento, lista. Com ids, marca. Com --undo, desmarca."""
    require_root()
    changes = adoption_changes()
    if changes is None:
        return fail("nao consegui ler a maquina")
    pending, accepted = acks.split(changes)
    if not args.ids:
        for cid, text in pending:
            say(f"  {YELLOW}pendente{OFF}     {cid}  {text}")
        for cid, text, mark in accepted:
            say(f"  {GREEN}intencional{OFF}  {cid}  {text}  {DIM}({mark.get('by', '?')}){OFF}")
        if not pending:
            say(f"{GREEN}nenhuma mudanca pendente{OFF}")
        return 0
    by_id = dict(pending)
    for cid in args.ids:
        if args.undo:
            say(f"  {cid}: {'desmarcada' if acks.unmark(cid) else 'nao estava marcada'}")
        elif cid in by_id:
            acks.mark(by_id[cid], by=os.environ.get("SUDO_USER") or "root")
            say(f"  {cid}: marcada como intencional")
        else:
            say(f"  {RED}{cid}: nao e' uma mudanca pendente desta maquina{OFF}")
    return 0


def cmd_observe(args: argparse.Namespace) -> int:
    """So le o sistema. E' o que o painel em modo somente leitura chama."""
    require_root()
    live = observe.collect()
    say(f"fotografia em {live}")
    return 0


def f2b_refusal(ip, cfg) -> str:
    """Por que este IP nao pode ser banido, ou vazio.

    Nenhum bloqueio alcanca a LAN, o tunel nem a rede de administracao: banir
    o proprio endereco por engano trancaria o dono do lado de fora, e a
    chance disso e' maior justo quando alguem esta testando o fail2ban.
    """
    if ip.is_loopback or ip.is_unspecified or ip.is_multicast:
        return "endereço local ou especial"
    protegidas = {"da LAN": cfg.lan.ipv4.network, "da rede de administração": cfg.system.admin_cidr}
    if cfg.wireguard.enabled and cfg.wireguard.address:
        protegidas["do túnel da VPN"] = str(ipaddress.ip_interface(cfg.wireguard.address).network)
    for nome, rede in protegidas.items():
        if rede and ip in ipaddress.ip_network(rede, strict=False):
            return f"está dentro {nome} ({rede})"
    return ""


def cmd_f2b(args: argparse.Namespace) -> int:
    """Bane ou desbane um IP num jail, conforme o pedido que o painel gravou.

    O pedido e' lido de um caminho fixo e apagado antes de qualquer coisa,
    para nunca ser executado duas vezes; depois, cada campo e' revalidado
    aqui, como root, sem confiar no que o painel validou.
    """
    require_root()
    try:
        raw = paths.F2B_REQUEST.read_text()[:1024]
        paths.F2B_REQUEST.unlink()
        pedido = json.loads(raw)
    except (OSError, ValueError):
        return fail("nenhum pedido de fail2ban legível")
    if not isinstance(pedido, dict):
        return fail("pedido de fail2ban malformado")

    acao, jail, alvo = (str(pedido.get(k, "")) for k in ("action", "jail", "ip"))
    if acao not in ("ban", "unban"):
        return fail(f"ação desconhecida: {acao!r}")
    try:
        ip = ipaddress.ip_address(alvo)
    except ValueError:
        return fail(f"endereço inválido: {alvo!r}")
    estado = observe.fail2ban()
    if estado is None:
        return fail("o fail2ban não respondeu: está parado ou não instalado")
    if jail not in {j["name"] for j in estado["jails"]}:
        return fail(f"jail inexistente: {jail!r}")
    if acao == "ban" and (motivo := f2b_refusal(ip, load(paths.CONFIG))):
        return fail(f"{ip} não pode ser banido: {motivo}")

    result = run("fail2ban-client", "set", jail, f"{acao}ip", str(ip))
    if not result.ok:
        return fail(f"fail2ban-client recusou: {result.output}")
    say(f"{'banido' if acao == 'ban' else 'desbanido'}: {ip} em {jail}")
    observe.collect()
    return 0


def _agente_files(nome: str, kind: str, level: str) -> None:
    """Escreve o que o nivel escolhido pede: env, drop-in da unidade e sudoers."""
    etc = Path(agentes.ETC)
    etc.mkdir(mode=0o755, exist_ok=True)
    (etc / f"{nome}.env").write_text(agentes.env_file(nome, kind))

    dropin = Path(agentes.DROPIN.format(nome))
    dropin.parent.mkdir(parents=True, exist_ok=True)
    dropin.write_text(agentes.dropin(nome, level))

    sudoers = Path(agentes.SUDOERS.format(nome))
    if level == "root":
        tmp = sudoers.with_name(f".{sudoers.name}.novo")
        tmp.write_text(agentes.sudoers(nome))
        tmp.chmod(0o440)
        if not run("visudo", "-cf", str(tmp), mutating=False).ok:
            tmp.unlink(missing_ok=True)
            raise ApplyError("a regra do sudoers do nivel root nao passou no visudo")
        tmp.replace(sudoers)
    else:
        sudoers.unlink(missing_ok=True)
    run("systemctl", "daemon-reload")


def _agente_state(update) -> None:
    state = agentes.load_state()
    update(state)
    agentes.STATE.write_text(json.dumps(state, indent=1, ensure_ascii=False))
    agentes.STATE.chmod(0o644)


def cmd_agente(args: argparse.Namespace) -> int:
    """Cria, muda o nivel, inicia, para e remove agentes no navegador.

    O pedido vem do painel por arquivo (o sudoers nao tem curinga), e' apagado
    antes de qualquer coisa e revalidado aqui. O nivel e' escolha do usuario:
    este comando so o traduz em arquivos (AGENTES.md).
    """
    require_root()
    try:
        raw = agentes.REQUEST.read_text()[:2048]
        agentes.REQUEST.unlink()
        pedido = json.loads(raw)
    except (OSError, ValueError):
        return fail("nenhum pedido de agente legivel")
    if not isinstance(pedido, dict):
        return fail("pedido de agente malformado")

    acao, nome = str(pedido.get("action", "")), str(pedido.get("name", ""))
    if not agentes.NAME_RE.match(nome):
        return fail(f"nome de agente invalido: {nome!r} (minusculas, numeros e '-', 2 a 16)")
    state = agentes.load_state()
    unit = agentes.UNIT.format(nome)
    user = agentes.user_of(nome)

    try:
        if acao == "criar":
            kind, level = str(pedido.get("kind", "")), str(pedido.get("level", ""))
            if kind not in agentes.CATALOG:
                return fail(f"agente desconhecido: {kind!r}")
            if level not in agentes.LEVELS or level in agentes.UNAVAILABLE:
                return fail(f"nivel indisponivel: {level!r}")
            if nome in state:
                return fail(f"ja existe um agente chamado {nome}")
            faltam = [p for p in agentes.CATALOG[kind].packages if not run("dpkg", "-s", p, mutating=False).ok]
            if faltam:
                say(f"instalando do Debian: {' '.join(faltam)}")
                result = run("apt-get", "install", "-y", "--no-install-recommends", *faltam, timeout=900)
                if not result.ok:
                    return fail(f"apt-get falhou: {result.output[-400:]}")
            Path(agentes.HOME).mkdir(mode=0o755, exist_ok=True)
            try:
                pwd.getpwnam(user)
            except KeyError:
                result = run(
                    "useradd", "--system", "--user-group", "--create-home",
                    "--home-dir", agentes.home_of(nome), "--shell", "/bin/bash", user,
                )
                if not result.ok:
                    return fail(f"useradd falhou: {result.output}")
            logs = Path(agentes.LOGS) / nome
            logs.mkdir(parents=True, exist_ok=True)
            shutil.chown(logs, user, user)
            _agente_files(nome, kind, level)
            _agente_state(lambda st: st.__setitem__(
                nome, {"kind": kind, "level": level, "created": datetime.now().isoformat(timespec="seconds")}))
            run("systemctl", "start", unit)
            say(f"agente {nome} criado ({agentes.CATALOG[kind].title}, nivel {level})")

        elif acao == "nivel":
            level = str(pedido.get("level", ""))
            if nome not in state:
                return fail(f"agente inexistente: {nome}")
            if level not in agentes.LEVELS or level in agentes.UNAVAILABLE:
                return fail(f"nivel indisponivel: {level!r}")
            _agente_files(nome, state[nome]["kind"], level)
            _agente_state(lambda st: st[nome].__setitem__("level", level))
            # o nivel vale na sessao nova: a que esta aberta reinicia
            if run("systemctl", "is-active", "--quiet", unit, mutating=False).ok:
                run("systemctl", "restart", unit)
            say(f"agente {nome} agora no nivel {level}")

        elif acao in ("iniciar", "parar"):
            if nome not in state:
                return fail(f"agente inexistente: {nome}")
            result = run("systemctl", "start" if acao == "iniciar" else "stop", unit)
            if not result.ok:
                return fail(result.output)
            say(f"agente {nome}: {'iniciado' if acao == 'iniciar' else 'parado'}")

        elif acao == "remover":
            if nome not in state:
                return fail(f"agente inexistente: {nome}")
            run("systemctl", "stop", unit)
            Path(agentes.SUDOERS.format(nome)).unlink(missing_ok=True)
            Path(agentes.ETC, f"{nome}.env").unlink(missing_ok=True)
            shutil.rmtree(Path(agentes.DROPIN.format(nome)).parent, ignore_errors=True)
            run("systemctl", "daemon-reload")
            run("userdel", "--remove", user)
            _agente_state(lambda st: st.pop(nome, None))
            say(f"agente {nome} removido (o registro das sessoes fica ate completar 30 dias)")
        else:
            return fail(f"acao desconhecida: {acao!r}")
    except ApplyError as exc:
        return fail(str(exc))
    return 0


def cmd_inventory(args: argparse.Namespace) -> int:
    """O que o motor possui, e o que roda nesta caixa sem dono.

    Leitura pura. A segunda metade e' o roteiro de adocao de uma caixa que
    nao nasceu do instalador: cada unidade sem dono ali ou vira um modulo de
    servico, ou vira uma decisao escrita de ficar de fora.
    """
    cfg = load(paths.PENDING if paths.PENDING.exists() and args.pending else paths.CONFIG)

    posses = ownership.survey(cfg)
    say(f"{BOLD}arquivos do motor{OFF} ({len(posses)})")
    largura = max((len(p.target) for p in posses), default=0)
    for p in posses:
        say(f"  {p.target:<{largura}}  {ROTULO.get(p.state, p.state)}  {DIM}{p.service}{OFF}")

    terr = ownership.territory(cfg)
    if not terr:
        say()
        say(f"{DIM}inventario de unidades indisponivel (sandbox ou systemd ausente){OFF}")
        return 0

    donas = [u for u in terr if not u.orfa]
    orfas = [u for u in terr if u.orfa]

    say()
    say(f"{BOLD}unidades com dono{OFF} ({len(donas)})")
    for u in donas:
        cor = GREEN if u.active == "active" else YELLOW
        say(f"  {u.unit:<32} {cor}{u.active}{OFF} {DIM}{u.enabled} — {u.service}{OFF}")

    say()
    if not orfas:
        say(f"{GREEN}nenhuma unidade habilitada fora do motor.{OFF}")
        return 0

    say(f"{YELLOW}{BOLD}unidades sem dono{OFF} ({len(orfas)}) {DIM}— o roteiro de adocao{OFF}")
    for u in orfas:
        cor = GREEN if u.active == "active" else DIM
        say(f"  {u.unit:<32} {cor}{u.active}{OFF} {DIM}{u.enabled}{OFF}")
    say()
    say(f"{DIM}Cada linha acima ou vira um modulo em fwadmin/services/, ou uma decisao{OFF}")
    say(f"{DIM}escrita de deixar de fora. Enquanto houver linhas, o config.yaml afirma{OFF}")
    say(f"{DIM}ser fonte da verdade de um sistema onde parte do /etc e' escrita a mao.{OFF}")
    return 0


def cmd_seal(args: argparse.Namespace) -> int:
    """Carimba o /etc atual como referencia de posse.

    E' o gesto de adocao de uma caixa que ja estava rodando: nada e' escrito
    em /etc, so se registra o que se viu. E o registro nunca mente — arquivo
    que difere do que o motor escreveria nao e' selado, e o comando diz qual.
    """
    require_root()
    cfg = load(paths.CONFIG)
    selados, recusados = ownership.seal(cfg)

    for name in selados:
        say(f"  {GREEN}selado{OFF} {name}")
    for name, porque in recusados:
        say(f"  {YELLOW}nao selado{OFF} {name}: {porque}")

    say()
    if recusados:
        say(f"{YELLOW}{len(selados)} selados, {len(recusados)} de fora.{OFF}")
        say("Um arquivo so e' selado quando e' identico ao que o motor escreveria.")
        say(f"Veja a diferenca com {BOLD}fwctl diff{OFF} e decida: trazer para o")
        say("config.yaml, ou aplicar por cima.")
        return 1
    say(f"{GREEN}os {len(selados)} arquivos do motor estao selados.{OFF}")
    return 0


def cmd_diff(args: argparse.Namespace) -> int:
    source = paths.PENDING if paths.PENDING.exists() else paths.CONFIG
    proposed, current = load_configs(source)
    plan = build_plan(proposed, current, paths.STAGING)
    if not plan.changed:
        say("sem diferencas")
        return 0
    import difflib

    for name in plan.changed:
        if name in plan.secret:
            say(f"{BOLD}--- {plan.targets[name]}{OFF}")
            say(f"{DIM}(arquivo de senha: o conteudo mudou e nao e' mostrado){OFF}")
            say()
            continue
        target = paths.sys_path(plan.targets[name])
        old = target.read_text().splitlines() if target.exists() else []
        new = plan.rendered[name].splitlines()
        say(f"{BOLD}--- {plan.targets[name]}{OFF}")
        for line in difflib.unified_diff(old, new, lineterm="", n=2):
            color = GREEN if line.startswith("+") else RED if line.startswith("-") else DIM
            say(f"{color}{line}{OFF}")
        say()
    return 0


def read_note() -> str:
    """Mensagem deixada pela UI para o commit deste apply.

    Vem por arquivo, nao por argumento, para o sudoers poder listar comandos
    exatos em vez de terminar em curinga.
    """
    try:
        note = paths.NOTE.read_text().strip()
    except OSError:
        return ""
    paths.NOTE.unlink(missing_ok=True)
    return note[:200].replace("\n", " ")


def committed_config():
    """A config do ultimo commit de /etc/fwadmin, ou None.

    Quem edita o config.yaml direto, sem apply, tira dele o papel de
    "o que foi selado"; o commit continua sendo o ultimo estado confirmado.
    """
    repo = paths.ETC
    if not (repo / ".git").exists():
        return None
    result = run(
        "git", "-c", f"safe.directory={repo}", "-C", str(repo), "show", "HEAD:config.yaml",
        mutating=False,
    )
    if not result.ok:
        return None
    try:
        return Config.model_validate(yaml.safe_load(result.output))
    except (ValueError, yaml.YAMLError):
        return None


def git_commit(message: str) -> None:
    """Versiona a config viva. O historico e' o rollback de longo prazo."""
    repo = paths.ETC
    # O diretorio pertence ao netadm, que precisa gravar a proposta; o git aqui
    # roda como root. Sem safe.directory o git recusa o repositorio.
    base = ["git", "-c", f"safe.directory={repo}", "-C", str(repo)]

    if not (repo / ".git").exists():
        run(*base, "init", "-q")
    run(*base, "add", "config.yaml")
    result = run(
        *base,
        "-c",
        "user.name=fwadmin",
        "-c",
        "user.email=fwadmin@localhost",
        "commit",
        "-q",
        "-m",
        message,
    )
    if result.ok:
        say(f"{DIM}versionado: {message}{OFF}")


# ---------------------------------------------------------------------------


def main() -> int:
    parser = argparse.ArgumentParser(prog="fwctl", description=__doc__)
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("check", help="valida e mostra o que mudaria").set_defaults(fn=cmd_check)
    sub.add_parser("status", help="mostra apply pendente").set_defaults(fn=cmd_status)
    sub.add_parser("diff", help="diff dos arquivos gerados").set_defaults(fn=cmd_diff)

    p_inv = sub.add_parser("inventory", help="posse dos arquivos e unidades sem dono")
    p_inv.add_argument("--pending", action="store_true", help="usa a config pendente")
    p_inv.set_defaults(fn=cmd_inventory)

    sub.add_parser("seal", help="sela o /etc atual como referencia").set_defaults(fn=cmd_seal)
    sub.add_parser("observe", help="fotografa o /etc vivo para o painel").set_defaults(
        fn=cmd_observe
    )

    p_ack = sub.add_parser("ack", help="mudancas da adocao: lista, marca ou desmarca")
    p_ack.add_argument("ids", nargs="*", help="ids a marcar como intencionais")
    p_ack.add_argument("--undo", action="store_true", help="desmarca os ids")
    p_ack.set_defaults(fn=cmd_ack)

    p_apply = sub.add_parser("apply", help="aplica a config pendente")
    p_apply.add_argument("--yes", action="store_true", help="aceita recargas que derrubam trafego")
    p_apply.add_argument("--force", action="store_true", help=argparse.SUPPRESS)
    p_apply.add_argument("--no-watchdog", action="store_true", help="nao arma o rollback automatico")
    p_apply.add_argument(
        "--discard-drift",
        action="store_true",
        help="sobrescreve arquivo editado a mao (guarda copia antes)",
    )
    p_apply.add_argument("--note", default="", help="mensagem do commit")
    p_apply.set_defaults(fn=cmd_apply)

    p_confirm = sub.add_parser("confirm", help="confirma o apply e versiona")
    p_confirm.set_defaults(fn=cmd_confirm)

    sub.add_parser(
        "f2b", help="bane ou desbane um IP, conforme o pedido gravado pelo painel"
    ).set_defaults(fn=cmd_f2b)
    sub.add_parser(
        "agente", help="cria, muda o nivel, inicia, para ou remove um agente no navegador"
    ).set_defaults(fn=cmd_agente)

    p_rb = sub.add_parser("rollback", help="desfaz o ultimo apply")
    p_rb.add_argument("--auto", action="store_true", help="chamado pelo watchdog")
    p_rb.set_defaults(fn=cmd_rollback)

    args = parser.parse_args()
    try:
        return args.fn(args)
    except ApplyError as exc:
        return fail(str(exc))
    except Exception as exc:  # noqa: BLE001 — root: melhor mensagem que traceback
        return fail(f"{type(exc).__name__}: {exc}")


if __name__ == "__main__":
    raise SystemExit(main())
