# ── Banco de dados ───────────────────────────────────────────────────────────
POSTGRES_DB=vpnweb
POSTGRES_USER=vpnweb
POSTGRES_PASSWORD=troque_esta_senha

DATABASE_URL=postgresql+asyncpg://vpnweb:troque_esta_senha@db:5432/vpnweb

# ── JWT ───────────────────────────────────────────────────────────────────────
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque_este_segredo_por_um_hex_de_64_chars

# ── Stripe (preencher na Fase 3) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
BRIDGE_SOCKET=/run/vpn-bridge/bridge.sock
SERVER_PUBLIC_IP=0.0.0.0        # IP público do servidor para o .conf do cliente
WG_SERVER_PORT=51820
